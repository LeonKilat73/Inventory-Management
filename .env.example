# Copy to .env.local and fill in from your Supabase project's
# Settings -> API page (https://supabase.com/dashboard/project/_/settings/api).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the notifications-dispatch webhook route checks against, so it
# only accepts calls that genuinely came from the Supabase Database Webhook.
# Generate any random string, e.g. `openssl rand -hex 32`.
NOTIFICATIONS_WEBHOOK_SECRET=

# Phase 4: email provider for notification delivery. Leave blank for now --
# the notification pipeline logs a no-op send until this is set.
RESEND_API_KEY=
